# Copy to .env and fill in. .env is gitignored.

# Path to your Google Cloud service-account JSON key.
#
# RECOMMENDED LOCATION: ~/.config/lead-scraper/credentials.json (chmod 600).
# The key is looked up in this order, first hit wins:
#   1. GOOGLE_SERVICE_ACCOUNT_JSON below
#   2. ~/.config/lead-scraper/credentials.json
#   3. ./credentials.json   (legacy, kept only so old checkouts keep working)
#
# !! ROTATE YOUR KEY !! The service-account key for project
# eighth-physics-491407-c6 sat unprotected in the repo root for months. Assume
# it is compromised: disable it in the Google Cloud console, issue a new one,
# and store the new one at the path above.
#
# credentials.json must NEVER be committed. .gitignore covers it -- but keep
# the key out of the project directory entirely and the question never comes up.
#
# Leave this unset if you used the recommended location: step 2 finds it. Set
# it only to point somewhere else.
#GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/credentials.json
